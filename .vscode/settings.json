{
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}/sources/poky/bitbake/lib",
        "${workspaceFolder}/sources/poky/meta/lib"
    ],
    "python.analysis.extraPaths": [
        "${workspaceFolder}/sources/poky/bitbake/lib",
        "${workspaceFolder}/sources/poky/meta/lib"
    ],
    "files.associations": {
        "RELEASE": "makefile",
        "CONFIG": "makefile",
        "**/configure/**": "makefile",
        "*.conf": "bitbake",
        "*.inc": "bitbake"
    },
    "python.analysis.exclude": [
        "layers/",
        "build/tmp/**",
        "build/tmp/*",
        "/build/tmp/**",
        "/build/tmp/*",
        "/build/**/*.py",
        "layers/**/*.py"
    ],
    "files.exclude": {
        "build/tmp/*": true
    },
    "files.watcherExclude": {
        "build/tmp/**": true
    }
}
